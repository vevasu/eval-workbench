# Needed to create projects and API keys (POST /admin/...). Pick any long random string.
EVAL_WORKBENCH_ADMIN_KEY=change-me
# Optional: any SQLAlchemy URL. Defaults to backend/workbench.db (SQLite).
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/workbench
# Local development only: an API key the web app may fetch from http://127.0.0.1:8000/dev-connect so it opens already
# connected. Only answers loopback requests from the same origin. Leave unset anywhere else.
# EVAL_WORKBENCH_DEV_KEY=ewb_...
