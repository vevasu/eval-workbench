# Set ONE of these. If both are set, Anthropic is used.
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible API
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: send a trace of each run to Eval Workbench (needs the SDK: pip install -e ../../sdk/python)
# EVAL_WORKBENCH_URL=http://127.0.0.1:8000
# EVAL_WORKBENCH_API_KEY=ewb_your-key-here
# APP_VERSION=v1                              # shown as the version of live traffic
